# ==========================================
# CitaVoz EPS (EPS TRIADIX) - Variables de Entorno
# ==========================================

# Zona Horaria (Colombia)
TZ=America/Bogota

# Base de Datos PostgreSQL con pgvector
# Si usas Docker Compose: postgresql://triadix_user:triadix_secret_2026@localhost:5432/triadix_citas
# Si dejas vacía o USE_EMBEDDED_DB=true, el sistema usa PGlite con soporte vectorial automático sin dependencias externas
DATABASE_URL=postgresql://triadix_user:triadix_secret_2026@localhost:5432/triadix_citas
USE_EMBEDDED_DB=false

# Clave simétrica para cifrado de datos sensibles en reposo (AES-256-GCM, 32 bytes en hex)
# Generada para entorno de desarrollo local (Ley 1581 / Habeas Data)
DATA_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Proveedor de IA (gemini | groq | ollama)
LLM_PROVIDER=gemini
GEMINI_API_KEY=tu_gemini_api_key_aqui

# Configuración de Servidor
PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

